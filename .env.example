# ============================================================
# Kisium TV – Server-Konfiguration
# Datei auf dem Server als ".env" kopieren und Werte ersetzen.
# Niemals committen. Rechte: chmod 600 .env
# ============================================================

# Kostenloser Netzkino-VOD-Endpunkt (GraphQL, kein API-Key)
VOD_FEED_URL=https://data.netzkino.de/netzkino/graphql

# Katalog-Sync
SYNC_INTERVAL_SECONDS=21600
PAGE_SIZE=100
VOD_FETCH_PAGE_SIZE=100
VOD_MAX_PAGES=100
OUTPUT_DIR=/data
# json | sqlite | both
OUTPUT_FORMAT=both
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=30
CONNECT_TIMEOUT_SECONDS=10
MAX_RETRIES=5
MIN_REQUEST_INTERVAL_SECONDS=0.4
VERIFY_TLS=true
HEADER_ROTATION=true
USER_AGENTS=KisiumCatalogSync/2.0 (+https://github.com/),VLC/3.0.20 LibVLC/3.0.20,okhttp/4.12.0

# Stream-Redirect-Proxy
PROXY_HOST=0.0.0.0
PROXY_PORT=5000
PROXY_BIND=0.0.0.0
# env | off (off = Pass-Through der App-Credentials)
PROXY_AUTH_MODE=env
PROXY_USERNAME=dein_user
PROXY_PASSWORD=dein_passwort

# Produktions-ASGI / Logging
WEB_CONCURRENCY=2
UVICORN_LOG_LEVEL=info
FORWARDED_ALLOW_IPS=127.0.0.1

# Admin-GUI unter /admin (Basic Auth + CSRF)
# Ohne diese beiden Werte ist /admin deaktiviert.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=bitte_langes_passwort_setzen
# true, wenn /admin ausschließlich über HTTPS erreichbar ist
ADMIN_COOKIE_SECURE=false

# Docker-Benutzer (muss zum Eigentümer von ./data passen)
# Wird vom deploy/install.sh automatisch auf den aktuellen Server-User gesetzt.
# KISIUM_UID=1000
# KISIUM_GID=1000

# Optional: Cache für /catalog.json (Sekunden)
CATALOG_CACHE_SECONDS=60
