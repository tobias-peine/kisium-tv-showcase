server {
    listen {{ kisium_tls_port }} ssl;
    server_name {{ kisium_domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ kisium_tls_cert_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ kisium_tls_cert_name }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    client_max_body_size 8m;
    proxy_read_timeout 60s;

    location / {
        proxy_pass http://127.0.0.1:{{ kisium_proxy_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
