VOD_FEED_URL={{ kisium_vod_feed_url }}
SYNC_INTERVAL_SECONDS={{ kisium_sync_interval_seconds | default(21600) }}
PAGE_SIZE=100
VOD_FETCH_PAGE_SIZE=100
VOD_MAX_PAGES=100
OUTPUT_DIR=/data
OUTPUT_FORMAT=both
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=30
CONNECT_TIMEOUT_SECONDS=10
MAX_RETRIES=5
MIN_REQUEST_INTERVAL_SECONDS=0.4
VERIFY_TLS=true
HEADER_ROTATION=true
USER_AGENTS=KisiumCatalogSync/3.0 (+https://github.com/),VLC/3.0.20 LibVLC/3.0.20,okhttp/4.12.0

PROXY_HOST=0.0.0.0
PROXY_PORT={{ kisium_proxy_port }}
PROXY_BIND={{ kisium_proxy_bind }}
PROXY_AUTH_MODE=env
PROXY_USERNAME={{ vault_kisium_proxy_username }}
PROXY_PASSWORD={{ vault_kisium_proxy_password }}

WEB_CONCURRENCY=2
UVICORN_LOG_LEVEL=info
FORWARDED_ALLOW_IPS=127.0.0.1
CATALOG_CACHE_SECONDS=60

ADMIN_USERNAME={{ vault_kisium_admin_username }}
ADMIN_PASSWORD={{ vault_kisium_admin_password }}
ADMIN_COOKIE_SECURE=true

KISIUM_UID={{ kisium_uid }}
KISIUM_GID={{ kisium_gid }}
KISIUM_SERVER_IP={{ kisium_domain }}
